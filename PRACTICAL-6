# 7. GRADIO CHATBOT UI
# ------------------------------------------------------------
def read_file(path):
    if path.lower().endswith(".pdf"):
        reader = PdfReader(path)
        return "\n".join((p.extract_text() or "") for p in reader.pages)
    with open(path, "r", encoding="utf-8", errors="ignore") as f:
        return f.read()

def ask(question):
    answer, hits = generate_answer(question)
    sources = "\n\n".join(f"**Source {i+1}** (similarity {s:.2f}):\n{c}"
                          for i, (c, s) in enumerate(hits))
    return answer, sources

def upload_docs(files):
    global chunks, chunk_embeddings
    if not files:
        return "No file selected."
    text = ""
    for f in files:
        path = f if isinstance(f, str) else f.name
        text += "\n\n" + read_file(path)
    new_chunks = chunk_text(text)
    if not new_chunks:
        return "Could not extract text from the file(s)."
    chunks = new_chunks
    chunk_embeddings = build_index(chunks)
    return f"✅ Knowledge base replaced. Indexed {len(chunks)} chunks. Go to the Ask tab."

def reset_kb():
    global chunks, chunk_embeddings
    chunks = chunk_text(KNOWLEDGE_BASE)
    chunk_embeddings = build_index(chunks)
    return f"♻️ Reset to the sample knowledge base ({len(chunks)} chunks)."


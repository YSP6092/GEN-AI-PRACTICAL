# 2. CHUNKING
# ------------------------------------------------------------
def chunk_text(text, max_words=110, overlap=25):
    text = text.replace("\r", "")
    chunks = []
    if "## " in text:  # structured FAQ / regulations
        for block in re.split(r"\n(?=## )", text.strip()):
            block = block.strip()
            if not block:
                continue
            title, *body = block.split("\n", 1)
            title = title.replace("##", "").strip()
            body = body[0].strip() if body else ""
            words = body.split()
            if len(words) <= max_words + 20:
                chunks.append(f"{title}: {body}")
            else:
                step = max_words - overlap
                for i in range(0, len(words), step):
                    chunks.append(f"{title}: " + " ".join(words[i:i + max_words]))
    else:  # plain text from uploaded PDF/TXT
        words = text.split()
        step = max_words - overlap
        for i in range(0, len(words), step):
            piece = " ".join(words[i:i + max_words])
            if len(piece.split()) > 15:
                chunks.append(piece)
    return chunks


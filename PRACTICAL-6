# 3. LOAD PRE-TRAINED MODELS
# ------------------------------------------------------------
print("Loading embedding model...")
embedder = SentenceTransformer("sentence-transformers/all-MiniLM-L6-v2", device=device)

MODEL_NAME = "google/flan-t5-large"   # use "google/flan-t5-base" on slow CPU
print("Loading language model...")
tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)
llm = AutoModelForSeq2SeqLM.from_pretrained(MODEL_NAME).to(device)
llm.eval()

def build_index(chunk_list):
    return embedder.encode(chunk_list, convert_to_numpy=True,
                           normalize_embeddings=True, show_progress_bar=False)

chunks = chunk_text(KNOWLEDGE_BASE)
chunk_embeddings = build_index(chunks)
print(f"Indexed {len(chunks)} chunks.")

# ------------------------------------------------------------
# 4. RETRIEVAL + ANSWER GENERATION
# ------------------------------------------------------------
SIM_THRESHOLD = 0.30   # below this -> "I don't know"
TOP_K = 3
FALLBACK = ("Sorry, I couldn't find this in the college regulations. "
            "Please contact the helpdesk: helpdesk@college.edu / 0712-555-0100.")

def retrieve(question, k=TOP_K):
    q_emb = embedder.encode([question], convert_to_numpy=True, normalize_embeddings=True)[0]
    scores = chunk_embeddings @ q_emb
    top = np.argsort(-scores)[:k]
    return [(chunks[i], float(scores[i])) for i in top]

def generate_answer(question, k=TOP_K):
    question = question.strip()
    if not question:
        return "Please type a question.", []
    hits = retrieve(question, k)
    if hits[0][1] < SIM_THRESHOLD:
        return FALLBACK, hits

    context = "\n".join(f"- {c}" for c, _ in hits)
    prompt = (
        "Answer the student's question using only the context below. "
        "Be clear and complete, and include specific numbers, dates and amounts when present. "
        "If the answer is not in the context, say \"I don't know\".\n\n"
        f"Context:\n{context}\n\nQuestion: {question}\n\nAnswer:"
    )
    inputs = tokenizer(prompt, return_tensors="pt", truncation=True, max_length=1024).to(device)
    with torch.no_grad():
        out = llm.generate(**inputs, max_new_tokens=160, num_beams=4,
                           no_repeat_ngram_size=3, early_stopping=True)
    answer = tokenizer.decode(out[0], skip_special_tokens=True).strip()
    if not answer or answer.lower().startswith("i don't know"):
        answer = "I couldn't find a clear answer in the regulations. Please contact helpdesk@college.edu / 0712-555-0100."
    return answer, hits


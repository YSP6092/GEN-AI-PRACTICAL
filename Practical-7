def llm_stream(messages, max_new_tokens=512, temperature=0.7, top_p=0.9, repetition_penalty=1.05):
    """Streams the growing response text for a list of chat messages."""
    text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
    inputs = tokenizer(text, return_tensors="pt").to(model.device)
    streamer = TextIteratorStreamer(tokenizer, skip_prompt=True, skip_special_tokens=True)
    kw = dict(**inputs, streamer=streamer, max_new_tokens=max_new_tokens,
              repetition_penalty=repetition_penalty, pad_token_id=tokenizer.eos_token_id)
    if temperature > 0:
        kw.update(do_sample=True, temperature=temperature, top_p=top_p)
    else:
        kw.update(do_sample=False)

    def worker():
        try:
            model.generate(**kw)
        except Exception as e:
            streamer.on_finalized_text(f"\n[Generation error: {e}]", stream_end=True)

    th = threading.Thread(target=worker); th.start()
    out = ""
    for piece in streamer:
        out += piece
        yield out
    th.join()

def llm(messages, **kw):
    out = ""
    for out in llm_stream(messages, **kw):
        pass
    return out.strip()


def fewshot_messages(task):
    fields, out = TASKS[task]["example"]
    return [{"role": "user", "content": TASKS[task]["builder"](fields)},
            {"role": "assistant", "content": out}]

# ------------------------------------------------------------------------------
# 3. THE GENERATION PIPELINE (few-shot + prompt chaining + self-refine)
# ------------------------------------------------------------------------------
def run_task(task, fields, few_shot=True, use_plan=False, refine=False, temperature=0.6):
    """Generator -> yields (status, text, prompt_log) so the UI can stream progress."""
    cfg = TASKS[task]
    user_prompt = cfg["builder"](fields)
    log = f"########## SYSTEM PROMPT (role + rules + format) ##########\n{cfg['system']}\n\n"

    plan_text = ""
    if use_plan:                                   # STAGE 1: planning (prompt chaining)
        yield "🧭 Step 1: planning the structure...", "", log
        plan_text = llm([{"role": "system", "content": PLAN_SYSTEM},
                         {"role": "user", "content": f"Writing request:\n{user_prompt}"}],
                        max_new_tokens=220, temperature=0.3)
        log += f"########## STAGE 1 - PLAN (prompt chaining) ##########\n{plan_text}\n\n"

    final_user = user_prompt + (f"\n\nFollow this plan while writing:\n{plan_text}" if plan_text else "")
    msgs = [{"role": "system", "content": cfg["system"]}]
    if few_shot:                                   # FEW-SHOT: worked example before the real request
        msgs += fewshot_messages(task)
        log += "########## FEW-SHOT ##########\n1 worked example (user request -> ideal answer) is inserted before your request.\n\n"
    msgs.append({"role": "user", "content": final_user})
    log += f"########## USER PROMPT ##########\n{final_user}\n\n"

    draft = ""
    for draft in llm_stream(msgs, max_new_tokens=cfg["max_tokens"], temperature=temperature):
        yield "✍️ Writing...", draft, log
    draft = draft.strip()

    if refine:                                     # STAGE 3: self-review (self-refine)
        yield "🔎 Reviewing the draft against a checklist...", draft, log
        refine_user = (f"Original request:\n{user_prompt}\n\nDraft:\n{draft}\n\n"
                       f"Checklist:\n{CHECKLISTS[task]}\n\n"
                       f"Fix any issue and output ONLY the improved final text in the same format.")
        log += f"########## STAGE 3 - SELF-REFINE CHECKLIST ##########\n{CHECKLISTS[task]}\n\n"
        final = draft
        for final in llm_stream([{"role": "system", "content": REFINE_SYSTEM},
                                 {"role": "user", "content": refine_user}],
                                max_new_tokens=cfg["max_tokens"], temperature=0.3):
            yield "✨ Polishing...", final, log
        draft = final.strip()

    yield "✅ Done", draft, log

def generate_text(task, fields, **kw):
    text = log = ""
    for _, text, log in run_task(task, fields, **kw):
        pass
    return text, log


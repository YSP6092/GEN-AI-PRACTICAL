MODES = {"General Assistant": (GENERAL_SYSTEM, None),
         "Email Writer": (EMAIL_SYSTEM, "email"),
         "Report Writer": (REPORT_SYSTEM, "report"),
         "Technical Explainer": (TECH_SYSTEM, "technical")}

def chat_fn(message, history, mode, temperature, use_few_shot):
    history = history or []
    if not message or not message.strip():
        yield history, ""
        return
    system, task = MODES[mode]
    msgs = [{"role": "system", "content": system}]
    if use_few_shot and task:
        msgs += fewshot_messages(task)
    msgs += [{"role": m["role"], "content": m["content"]} for m in history[-8:]]
    msgs.append({"role": "user", "content": message})
    history = history + [{"role": "user", "content": message}, {"role": "assistant", "content": ""}]
    for partial in llm_stream(msgs, max_new_tokens=800, temperature=temperature):
        history[-1]["content"] = partial
        yield history, ""

TECHNIQUES = ["Few-shot examples", "Plan first (prompt chaining)", "Self-review & refine"]
def opts_to_kw(opts, temp):
    return dict(few_shot=TECHNIQUES[0] in opts, use_plan=TECHNIQUES[1] in opts,
                refine=TECHNIQUES[2] in opts, temperature=temp)

def ui_email(ctx, rec, snd, tone, length, opts, temp):
    if not ctx.strip():
        yield "⚠️ Please describe what the email should say.", "", ""; return
    f = dict(context=ctx, recipient=rec or "the recipient", sender=snd, tone=tone, length=length)
    yield from run_task("email", f, **opts_to_kw(opts, temp))

def ui_report(topic, rtype, aud, pts, tone, length, opts, temp):
    if not topic.strip():
        yield "⚠️ Please enter a topic.", "", ""; return
    f = dict(topic=topic, report_type=rtype, audience=aud or "General readers", key_points=pts, tone=tone, length=length)
    yield from run_task("report", f, **opts_to_kw(opts, temp))

def ui_tech(topic, aud, length, code, opts, temp):
    if not topic.strip():
        yield "⚠️ Please enter a topic.", "", ""; return
    f = dict(topic=topic, audience=aud, length=length, code=code)
    yield from run_task("technical", f, **opts_to_kw(opts, temp))


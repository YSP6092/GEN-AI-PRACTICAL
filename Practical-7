TASKS = {
    "email":     dict(system=EMAIL_SYSTEM,  builder=build_email_prompt,  max_tokens=500,
                      example=(EMAIL_EX_FIELDS, EMAIL_EX_OUT)),
    "report":    dict(system=REPORT_SYSTEM, builder=build_report_prompt, max_tokens=1200,

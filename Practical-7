def banner(t):
    print("\n" + "=" * 90 + f"\n{t}\n" + "=" * 90)

def scorecard(title, checks):
    print(f"\n  📋 {title}")
    for k, v in checks.items():
        print(f"     {'✅' if v else '❌'} {k}")
    print(f"     → {sum(checks.values())}/{len(checks)} checks passed")

def check_email(t, sender):
    wc = len(t.split())
    return {"Starts with 'Subject:' line": t.strip().lower().startswith("subject:"),
            "Has a greeting": bool(re.search(r"\b(dear|hi|hello)\b", t, re.I)),
            "Signed with sender name": sender.lower() in t.lower(),
            "Length 90-220 words (target ~150)": 90 <= wc <= 220,
            "No chatty preamble (e.g. 'Sure!', 'Here is')": not re.match(r"\s*(sure|certainly|here is|here's|of course)", t, re.I)}

def check_sections(t, sections):
    return {f"Section '{s}'": s.lower() in t.lower() for s in sections}


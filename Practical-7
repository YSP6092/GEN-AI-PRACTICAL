                t_btn = gr.Button("Explain", variant="primary")
            with gr.Column():
                t_status = gr.Markdown()
                t_out = gr.Textbox(label="Explanation (Markdown)", lines=24, show_copy_button=True)
                with gr.Accordion("🔍 Engineered prompt (what the LLM saw)", open=False):
                    t_log = gr.Textbox(lines=14, show_label=False)
        t_btn.click(ui_tech, [t_topic, t_aud, t_len, t_code, t_opts, t_temp], [t_status, t_out, t_log])
        gr.Examples(examples=[["How does a hash table work?", "Beginner (ELI5)", "Short", True],
                              ["What is the CAP theorem?", "Working professional", "Medium", False]],
                    inputs=[t_topic, t_aud, t_len, t_code], cache_examples=False)

    # ---------------- Techniques tab ----------------
    with gr.Tab("📘 Techniques Used"):
        gr.Markdown("""
| # | Prompt-engineering technique | How it is used in this app |
|---|---|---|
| 1 | **Role prompting** | System prompts make the LLM act as an email writer, report analyst or senior engineer-teacher |
| 2 | **Structured output / format constraints** | Fixed formats: `Subject:` line for emails, 7 sections for reports, 6 sections for explanations |
| 3 | **Negative constraints** | "Never invent facts", "no text before or after" - reduces hallucination and chatty replies |
| 4 | **Parameterised prompt templates** | Tone, length, audience and report type are injected into the prompt from form fields |
| 5 | **Few-shot prompting** | One ideal worked example (request -> answer) is placed before the real request |
| 6 | **Prompt chaining** | Stage 1 plans the outline, Stage 2 writes the draft using that plan |
| 7 | **Self-refine (critique and rewrite)** | The draft is checked against a checklist and rewritten by an "editor" prompt |
| 8 | **Decoding control** | Temperature, top-p, repetition penalty and max tokens tune creativity and length |

**Tip:** open the *Engineered prompt* accordion after generating to see exactly what the model received.
""")


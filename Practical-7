# ---- User-prompt builders (turn form fields into a structured prompt) ----
def build_email_prompt(f):
    return (f"Write an email using the details below.\n\n"
            f"Purpose / context: {f['context']}\n"
            f"Recipient: {f['recipient']}\n"
            f"Sender name: {f['sender'] or '[Your Name]'}\n"
            f"Tone: {f['tone']} ({TONES[f['tone']]})\n"
            f"Length: {f['length']} ({EMAIL_LEN[f['length']]})")

def build_report_prompt(f):
    return (f"Write a report using the details below.\n\n"
            f"Topic: {f['topic']}\n"
            f"Report type: {f['report_type']}\n"
            f"Audience: {f['audience']}\n"
            f"Key points / data to include: {f['key_points'] or 'None provided - keep it general and do not fabricate numbers'}\n"
            f"Tone: {f['tone']} ({TONES[f['tone']]})\n"
            f"Length: {f['length']} ({REPORT_LEN[f['length']]})")

def build_tech_prompt(f):
    return (f"Explain the following technical topic.\n\n"
            f"Topic: {f['topic']}\n"
            f"Audience: {f['audience']} ({AUDIENCES[f['audience']]})\n"
            f"Length: {f['length']} ({TECH_LEN[f['length']]})\n"
            f"Include a short Python code example: {'yes' if f['code'] else 'no'}")

